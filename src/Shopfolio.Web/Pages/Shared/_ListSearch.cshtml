@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Lists
@model ListSearch
@* The search field of a list (04 2.13.2; T545): only the lists the table gives a search draw it - the form is a GET to the list's own address with the one parameter, and a changed word returns
   to the first page because the form carries no page. Coupons, the corporate content and the other lists have none. A wrong value is the field's own message under the field (04 2.3.1.1; T533). *@
@if (Model.IsShown)
{
    <form class="list-search" method="get" action="@Model.ListRoot" role="search">
        <label class="list-search__label" for="@ListSearch.FieldId">@Model.Label</label>
        @if (Model.Message is not null)
        {
            <input class="list-search__field" id="@ListSearch.FieldId" type="search" name="search" value="@Model.Value" aria-invalid="true" aria-describedby="@Messages.FieldMessageId(ListSearch.FieldId)" />
        }
        else
        {
            <input class="list-search__field" id="@ListSearch.FieldId" type="search" name="search" value="@Model.Value" />
        }
        <button class="button button--secondary list-search__submit" type="submit">Ara</button>
        @if (Model.Message is not null)
        {
            MessageView fieldMessage = Messages.ForField(ListSearch.FieldId, Model.Message);
            <partial name="_Message" model="fieldMessage" />
        }
    </form>
}
