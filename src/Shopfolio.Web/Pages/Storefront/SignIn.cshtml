@page "/giris"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Infrastructure
@using Shopfolio.Infrastructure.SearchEngine
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Frame
@model Shopfolio.Pages.Storefront.SignInModel
@inject SearchEngineData Search
@*
    The customer's sign-in (T515; 04 5.22; 07 UC-54, UC-55). Order of the content (04 5.22.3): the heading, the lasting message of the result state, "Google ile giriş" (only when the Google application is defined),
    the form (e-mail, password, "beni hatırla" unticked), the button - the neutral limit sentence beside it after a 429 - and the links of the password reset and of the registration. A right pair of an unverified
    account replaces the form with the awaited-verification state and the button for the link (04 5.22.8). The password is never written back into the page.
*@
@{
    Layout = "_StorefrontLayout";
    ViewData["Title"] = SignInTexts.ScreenName;
    FormErrorSummary summary = FormErrorSummary.From(ViewData.ModelState, ["Input.Email", "Input.Password"]);
    FieldView email = Fields.Bind(Fields.Email("Input.Email", SignInTexts.EmailLabel, FieldRequirement.Required, Model.Input.Email, "username"), summary);
    FieldView concealedField = Fields.Bind(Fields.Concealed("Input.Password", SignInTexts.PasswordLabel, FieldRequirement.Required, "current-password"), summary);
}
@section Head {
    @Search.Head(ViewContext.HttpContext, RecordPages.ClosedScreen(SignInTexts.ScreenName, ViewContext.HttpContext.GetStorefrontFrame()?.Brand.BrandName, FramePaths.SignIn))
}
<h1>@SignInTexts.ScreenName</h1>
@if (Model.ResultMessage is not null)
{
    <partial name="_Message" model="Model.ResultMessage" />
}
@if (Model.GoogleOpen)
{
    <form method="post" asp-antiforgery="true" action="@(FramePaths.SignIn)?handler=StartSocialLogin" id="google-sign-in" data-js="submit-once">
        @if (Model.Input.ReturnUrl is not null)
        {
            <input type="hidden" name="ReturnUrl" value="@Model.Input.ReturnUrl">
        }
        <button type="submit" class="button button--secondary" data-busy-label="@LoadingViews.BusyLabelOf(SignInTexts.GoogleLabel)">@SignInTexts.GoogleLabel</button>
        <p class="sign-in__privacy"><a href="@FramePaths.PrivacyNotice">@SignInTexts.PrivacyNoticeLabel</a></p>
    </form>
}
@if (Model.Pending is not null)
{
    <section class="registration-sent" id="sign-in-pending">
        @if (Model.LinkWasResent)
        {
            <partial name="_Message" model="Messages.InPlace(MessageMeaning.Success, RegistrationTexts.LinkResent(Model.Pending.LinkEndsAt))" />
        }
        <partial name="_Message" model="Messages.InPlace(MessageMeaning.Warning, SignInTexts.EmailNotVerified)" />
        <partial name="_Message" model="Messages.InPlace(MessageMeaning.Info, RegistrationTexts.Submitted(Model.Pending.Email, Model.Pending.LinkEndsAt))" />
        <form method="post" asp-antiforgery="true" action="@(FramePaths.SignIn)?handler=ResendVerificationLink" data-js="submit-once">
            <input type="hidden" name="PendingRegistration" value="@Model.PendingValue" />
            <button type="submit" class="button button--secondary" data-busy-label="@LoadingViews.BusyLabelOf(RegistrationTexts.ResendLabel)">@RegistrationTexts.ResendLabel</button>
            @if (Model.ResendLimitReached)
            {
                <partial name="_Message" model='Messages.NeutralLimit("resend-limit")' />
            }
        </form>
    </section>
}
else
{
    <partial name="_FormErrorSummary" model="summary" />
    <form method="post" asp-antiforgery="true" action="@(FramePaths.SignIn)?handler=SignIn" id="sign-in-form" class="form" data-js="submit-once">
        @if (Model.CredentialsRefused)
        {
            <partial name="_Message" model='Messages.InPlace(MessageMeaning.Error, SignInTexts.InvalidCredentials, "sign-in-refused")' />
        }
        <div class="form-fields">
            <partial name="_Field" model="email" />
            <partial name="_Field" model="concealedField" />
            <div class="field field--check">
                <input type="checkbox" id="Input_IsLongLived" name="Input.IsLongLived" value="true" checked="@Model.Input.IsLongLived">
                <label for="Input_IsLongLived">@SignInTexts.RememberMeLabel</label>
            </div>
        </div>
        @if (Model.Input.ReturnUrl is not null)
        {
            <input type="hidden" name="Input.ReturnUrl" value="@Model.Input.ReturnUrl">
        }
        <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(SignInTexts.ScreenName)">@SignInTexts.ScreenName</button>
        @if (Model.LimitReached)
        {
            <partial name="_Message" model='Messages.NeutralLimit("sign-in-limit")' />
        }
    </form>
}
<p><a href="@FramePaths.PasswordReset">@SignInTexts.ForgotLink</a></p>
<p><a href="@FramePaths.Register">@SignInTexts.RegisterLink</a></p>
