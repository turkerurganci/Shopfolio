@page "/panel/dogrulama/{key}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Frame
@using Shopfolio.Pages.Panel
@model Shopfolio.Pages.Panel.VerifyModel
@*
    The new address's landing screen (T521; 04 9.25.4; E-54): no frame, independent of a session (04 2.2.9). A valid link: one sentence and the one button; opening verifies nothing (K-904). Done, invalid and
    rejected: one sentence and the next step's link. No form but the one button.
*@
@{
    Layout = "_PanelBareLayout";
    ViewData["Title"] = PanelAccessTexts.VerifyEmailTitle;
}
<h2>@PanelAccessTexts.VerifyEmailTitle</h2>
@switch (Model.Step)
{
    case LandingStep.Valid:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Info, PanelAccessTexts.VerifyEmailValid, "verify-email-valid")' />
        <form method="post" asp-antiforgery="true" action="@(PanelFramePaths.EmailVerification)/@(Uri.EscapeDataString(Model.Key))?handler=VerifyEmail" class="form" data-js="submit-once">
            <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(PanelAccessTexts.VerifyEmailButton)">@PanelAccessTexts.VerifyEmailButton</button>
        </form>
        break;
    case LandingStep.Done:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Success, PanelAccessTexts.EmailVerified, "verify-email-done")' />
        <p><a href="@Model.NextPath">@Model.NextText</a></p>
        break;
    case LandingStep.Rejected:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Warning, PanelAccessTexts.VerifyEmailTaken, "verify-email-taken")' />
        <p><a href="@Model.NextPath">@Model.NextText</a></p>
        break;
    default:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Warning, PanelAccessTexts.VerifyEmailInvalid, "verify-email-invalid")' />
        <p><a href="@Model.NextPath">@Model.NextText</a></p>
        break;
}
