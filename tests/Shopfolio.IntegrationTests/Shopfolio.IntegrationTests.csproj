<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>shopfolio-integration-tests</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shopfolio.Web\Shopfolio.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hand-written fakes are shared as linked files; no second copy, no reference between test projects (09 19.1 item 3; K-1355). -->
    <Compile Include="..\Shopfolio.UnitTests\Fakes\**\*.cs" LinkBase="Fakes" />
    <Compile Include="..\Shopfolio.UnitTests\Support\RepositoryRoot.cs" LinkBase="Support" />
    <!-- The sample entities of the model rule tests and the storage type table are shared the same way (T101). -->
    <Compile Include="..\Shopfolio.UnitTests\Samples\**\*.cs" LinkBase="Samples" />
    <Compile Include="..\Shopfolio.UnitTests\Consistency\ColumnTypeTable.cs" LinkBase="Consistency" />
    <!-- The test images and the image reader of the image tests are shared the same way (T223); the fixture files are read from the repository. -->
    <Compile Include="..\Shopfolio.UnitTests\Imaging\ImageFixtures.cs" LinkBase="Imaging" />
    <Compile Include="..\Shopfolio.UnitTests\Imaging\ImageInspection.cs" LinkBase="Imaging" />
  </ItemGroup>

</Project>
