#!/usr/bin/env bash
# Project Playbook pre-commit hook — secret guard.
#
# The rule "secrets are never committed" is declared in several places
# (GUARDRAILS, methodology mini security check, PR template). This hook is
# its `exit 1` counterpart: it inspects what is ACTUALLY staged.
#
# Layer 1 (path)    — a staged path looks like a secret file
# Layer 2 (content) — staged content contains a private key block, or assigns
#                     a real-looking value to a known secret key name
#
#                     Two narrow carve-outs, nothing else:
#                     1. Generated package lock files (packages.lock.json,
#                        package-lock.json, yarn.lock, pnpm-lock.yaml,
#                        Cargo.lock, poetry.lock) skip the assignment check.
#                        Layer 1 and the private key check still apply.
#                     2. In source code files (.cs .ts .tsx .js .jsx .py .go
#                        .rb .php .java .kt .rs .swift .razor .cshtml) a line is
#                        not a candidate when its right side (trailing ; , ) {
#                        and blanks trimmed) is ENTIRELY one of: a single
#                        identifier or dotted chain (CancellationToken,
#                        builder.ConnectionString), nameof(<chain>), null,
#                        default, default(<type>), or a placeholder. Anything
#                        with a quote, bracket, operator or digit start is
#                        still checked.
#                        Known limit: `Token = AKIAEXAMPLEKEY123` (bare
#                        identifier) passes in source code.
#
# Deliberately generic: no domain- or vendor-specific patterns. Project
# specifics go in scripts/git-hooks/hooks.config, not here.
#
# Bypass: PB_ALLOW_SECRET=1 PB_BYPASS_REASON="..." git commit -m "..."

set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
[ -f "$HOOK_DIR/hooks.config" ] && . "$HOOK_DIR/hooks.config"

# Paths that must never be committed. Extend via hooks.config.
SECRET_PATHS="${PB_SECRET_PATHS:-}"
DEFAULT_SECRET_PATHS='(^|/)\.env($|\.)|(^|/)\.netrc$|(^|/)secrets/|\.pem$|\.p12$|\.pfx$|\.keystore$|(^|/)id_rsa($|\.)|(^|/)id_ed25519($|\.)'

# Key names whose assignment to a real value is blocked. Extend via hooks.config.
SECRET_KEYS="${PB_SECRET_KEYS:-}"
DEFAULT_SECRET_KEYS='(SECRET|PASSWORD|PASSWD|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|TOKEN|CLIENT_?SECRET|CONNECTION_?STRING)'

# Values that are obviously not real secrets.
PLACEHOLDER='^[[:space:]]*("|'"'"')?(<[^>]*>|\$\{[^}]*\}|changeme|change_me|xxx+|todo|placeholder|your[-_].*|example|dummy|\*+|)("|'"'"')?[[:space:]]*$'

log_bypass() {
  local repo_root log_file timestamp git_user reason note="$1"
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  log_file="$repo_root/Docs/BYPASS_LOG.md"
  [ -f "$log_file" ] || return 0
  timestamp="$(date -u '+%Y-%m-%d %H:%M UTC')"
  git_user="$(git config user.name || echo 'unknown')"
  reason="${PB_BYPASS_REASON:-*(sebep belirtilmedi)*}"
  echo "| $timestamp | $git_user | $(git symbolic-ref --short HEAD 2>/dev/null || echo '-') | (pre-commit) | **[secret]** $reason — $note |" >> "$log_file"
  echo "BYPASS LOG: Docs/BYPASS_LOG.md'ye kayit eklendi (secret)." >&2
}

STAGED="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -n "$STAGED" ] || exit 0

FINDINGS=""
# SAFE_SUMMARY never contains matched content — it is written to a tracked log
# file. Echoing the secret into Docs/BYPASS_LOG.md would commit the very thing
# this hook exists to stop.
SAFE_SUMMARY=""
add_finding() {
  # $1 = detailed message (stderr only), $2 = redacted summary (log-safe)
  FINDINGS="${FINDINGS}  - $1"$'\n'
  SAFE_SUMMARY="${SAFE_SUMMARY:+$SAFE_SUMMARY; }$2"
}

# --- Layer 1: path check ----------------------------------------------------
while IFS= read -r path; do
  [ -n "$path" ] || continue
  # The template file is the one thing we DO track.
  case "$path" in
    *.env.example|*.env.sample|*/secrets/README.md|secrets/README.md) continue ;;
  esac
  if echo "$path" | grep -qE "$DEFAULT_SECRET_PATHS"; then
    add_finding "yol: $path (sir dosyasi deseni)" "yol:$path"
  elif [ -n "$SECRET_PATHS" ] && echo "$path" | grep -qE "$SECRET_PATHS"; then
    add_finding "yol: $path (PB_SECRET_PATHS deseni)" "yol:$path"
  fi
done <<< "$STAGED"

# --- Layer 2: content check -------------------------------------------------
KEY_RE="$DEFAULT_SECRET_KEYS"
[ -n "$SECRET_KEYS" ] && KEY_RE="($DEFAULT_SECRET_KEYS|$SECRET_KEYS)"

# is_secret_assignment <candidate>: 0 when the candidate assigns a real value to
# a secret key name, 1 otherwise. Reads $path and $is_code of the file in hand.
is_secret_assignment() {
  local body="$1" lhs value v_loose v_strict v_noq ID CHAIN EFARG MULTI
  # The key name must sit on the LEFT of the first = or : — that is what an
  # assignment looks like (API_KEY=..., "token": ..., password: ...). Prose
  # that merely mentions the word after a label ("Sorun: ... token ...")
  # is not an assignment; flagging it trained the workaround of hiding text
  # in blockquotes (learning promotion, Phase 1, 2026-10-03).
  lhs="${body%%[=:]*}"
  [ "$lhs" != "$body" ] || return 1
  echo "$lhs" | grep -qiE "$KEY_RE" || return 1
  # The left side must look like a key: at most two prefix words (export, const ...)
  # and then one identifier. A sentence or a URL path that merely contains the word
  # ("POST /odeme/api/get-token: ...") is prose (Phase 9: false positive on a task
  # block, learning promotion Ö-171).
  echo "$lhs" | grep -qE "^[[:space:]]*([\"']?[A-Za-z]+[\"']?[[:space:]]+){0,2}[\"']?[]A-Za-z0-9_.[-]+[\"']?[[:space:]]*\$" || return 1
  # Grab whatever is on the right-hand side of = or :
  value="$(echo "$body" | sed -E 's/^[^=:]*[=:][[:space:]]*//')"
  MULTI=0
  if [ "$is_code" = "1" ]; then
    # Narrow carve-out: the whole right side is an identifier, dotted chain,
    # nameof(chain), null, default, default(Type) or a placeholder -- not a
    # literal.
    ID='[A-Za-z_][A-Za-z0-9_]*'
    CHAIN="$ID(\\.$ID)*"
    v_loose="$(echo "$value" | sed -E 's/[;,){[:space:]]*$//')"
    v_strict="$(echo "$value" | sed -E 's/[;,{[:space:]]*$//')"
    echo "$v_loose" | grep -qE "^$CHAIN\$" && return 1
    # Placeholder carve-out applies to a single literal only: a concatenation,
    # list or several quoted parts ("<" + secret + ">") is still checked.
    MULTI=0
    echo "$v_loose" | grep -qE '[+,=]|(["'"'"'].*){3}' && MULTI=1
    if [ "$MULTI" = "0" ]; then
      echo "$v_loose" | grep -qiE "$PLACEHOLDER" && return 1
    fi
    echo "$v_strict" | grep -qE "^(nameof\\($CHAIN\\)|default\\($CHAIN\\))\$" && return 1
    # EF migration column constructor (generated code, no value assigned):
    # the right side is exactly table.Column<Type>(args). The only quoted
    # string allowed is the value of the named argument type: "..." in PostgreSQL type-name form (lowercase letter
    # first, then lowercase letters, digits, spaces; optional trailing
    # "(digits, commas, spaces)"; no underscore, uppercase, hyphen); the
    # other arguments are literal-free named values (nullable, maxLength,
    # precision, scale, unicode, fixedLength). Any other quoted string,
    # positional literal, concatenation or second call keeps the normal
    # rule. The call must close on the same line (open multi-line form is
    # not exempt: its continuation lines would go unchecked). .cs only.
    case "$path" in
      *.cs)
        v_noq="$(echo "$value" | sed -E 's/([(,][[:space:]]*)type:[[:space:]]*"[a-z][a-z0-9 ]*(\([0-9, ]+\))?"/\1type: T/g; s/[[:space:]]+$//')"
        EFARG='[[:space:]]*(type|nullable|maxLength|precision|scale|unicode|fixedLength)[[:space:]]*:[[:space:]]*[A-Za-z0-9_.]+[[:space:]]*,?'
        echo "$v_noq" | grep -qE "^table\\.Column<[A-Za-z0-9_.?]+>\\(($EFARG)*\\)[,;]?\$" && return 1
        ;;
    esac
  fi
  # In source code a multi-part right side never counts as a placeholder.
  if [ "${MULTI:-0}" = "0" ]; then
    echo "$value" | grep -qiE "$PLACEHOLDER" && return 1
  fi
  # Ignore prose/markdown and code that merely names the key.
  echo "$body" | grep -qE '^[[:space:]]*(#|//|\*|>|\|)' && return 1
  [ "${#value}" -lt 8 ] && return 1
  return 0
}

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    *.env.example|*.env.sample) continue ;;
    # This hook itself and its docs describe the patterns on purpose.
    scripts/git-hooks/pre-commit|scripts/git-hooks/README.md) continue ;;
  esac
  # Generated package lock files hold names and hashes, never authored secrets.
  # (Layer 1 path check and the private key block check do not skip them.)
  is_lock=0
  case "$path" in
    packages.lock.json|*/packages.lock.json|package-lock.json|*/package-lock.json|yarn.lock|*/yarn.lock|pnpm-lock.yaml|*/pnpm-lock.yaml|Cargo.lock|*/Cargo.lock|poetry.lock|*/poetry.lock) is_lock=1 ;;
  esac
  # Narrow identifier carve-out applies to source code files only.
  is_code=0
  case "$path" in
    *.cs|*.ts|*.tsx|*.js|*.jsx|*.py|*.go|*.rb|*.php|*.java|*.kt|*.rs|*.swift|*.razor|*.cshtml) is_code=1 ;;
  esac
  # Only added lines, and skip binaries.
  added="$(git diff --cached -U0 -- "$path" 2>/dev/null | grep -E '^\+[^+]' || true)"
  [ -n "$added" ] || continue

  if echo "$added" | grep -qE 'BEGIN ([A-Z ]+ )?PRIVATE KEY'; then
    add_finding "icerik: $path — private key blogu" "private-key:$path"
  fi

  [ "$is_lock" = "1" ] && continue

  # Pre-filter in one pass: strip the single leading "+" and keep only lines that
  # mention a key name. Spawning grep per added line is very slow on Windows
  # (a 7600-line migration took minutes); the loop below sees only candidates.
  candidates="$(echo "$added" | sed 's/^+//' | grep -iE "$KEY_RE" || true)"
  [ -n "$candidates" ] || continue

  while IFS= read -r line; do
    # A shell option that passes an environment variable (-e "KEY=value",
    # -e KEY=value, --env "KEY=value", --env=KEY=value) is an assignment too:
    # strip the option so the key-shape check below sees the key (D-80; the
    # package build script carries its made-up CI values in this form).
    # Every such option on the line is its own candidate, not only the one at
    # the start: a second option on the same line (-e A=x -e API_KEY=...) and
    # an option inside a one-line command (docker run --rm -e "KEY=..." img)
    # are checked too (D-1036). The candidate is the option's one shell word
    # (bare, quoted, or bare with quoted parts), so the next option or the
    # image name is not read as part of the value. The whole line, with a
    # leading option stripped, stays the first candidate as before.
    # A prose/markdown or comment line is skipped as a whole, options included.
    echo "$line" | grep -qE '^[[:space:]]*(#|//|\*|>|\|)' && continue
    first="$(printf '%s' "$line" | sed -E 's/^([[:space:]]*)(-e|--env)([[:space:]]+|=)/\1/')"
    options="$(printf '%s\n' "$line" | grep -oE "(^|[[:space:]])(-e|--env)([[:space:]]+|=)([^[:space:]\"']|\"[^\"]*\"|'[^']*')+" | sed -E 's/^[[:space:]]*(-e|--env)([[:space:]]+|=)//' || true)"
    caught=0
    while IFS= read -r body; do
      [ -n "$body" ] || continue
      if is_secret_assignment "$body"; then
        caught=1
        break
      fi
    done <<< "$first"$'\n'"$options"
    [ "$caught" = "1" ] || continue
    add_finding "icerik: $path — sir anahtarina gercek deger atamasi: $(echo "$line" | cut -c1-60)" "anahtar-atamasi:$path"
    break
  done <<< "$candidates"
done <<< "$STAGED"

[ -n "$FINDINGS" ] || exit 0

if [ "${PB_ALLOW_SECRET:-0}" = "1" ]; then
  log_bypass "$SAFE_SUMMARY"
  echo "WARN: PB_ALLOW_SECRET=1 — sir guard bulgulari yok sayildi." >&2
  exit 0
fi

cat <<EOF >&2

==============================================================================
HATA: Sir guard staged degisiklikte sir tespit etti (pre-commit).
==============================================================================

$FINDINGS
Sir degerleri repo'ya girmez. Repo yalniz SABLONU izler (.env.example).

Cozumler:
  1. Dosyayi staged'den cikar:      git restore --staged <dosya>
  2. .gitignore'a ekle (SETUP §2):  .env / .env.* / !.env.example
  3. Gercek degeri sablondan cikar, yerine <PLACEHOLDER> yaz
  4. Deger zaten commit'lendiyse:   sirri DONDUR, gecmisi temizlemek yetmez

Yanlis pozitif ise: anahtar adini veya yolu hooks.config'te daralt
  (PB_SECRET_KEYS / PB_SECRET_PATHS), ya da placeholder bicimi kullan.

Acil durum bypass (BYPASS_LOG'a kayit dusulur):
  PB_ALLOW_SECRET=1 PB_BYPASS_REASON="aciklama" git commit -m "..."

==============================================================================

EOF
exit 1
