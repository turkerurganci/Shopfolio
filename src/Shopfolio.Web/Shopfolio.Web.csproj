<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shopfolio</RootNamespace>
    <!-- With a .razor file (the e-mail frame, T305) the Web SDK would add Microsoft.AspNetCore.App.Internal.Assets (the Blazor script assets) to the restore by itself,
         and the container restore, which sees the project file only, would then read other references than the lock file. The application serves no Blazor script. -->
    <RequiresAspNetWebAssets>false</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The business day calendar's holiday list ships inside the application (05 7.2.3). -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/PublicHolidays.txt" LogicalName="Shopfolio.Infrastructure.PublicHolidays.txt" />
  </ItemGroup>

  <!-- The templates of the two generated legal texts ship inside the application (02 3.33.1; 09 11.4 item 5). -->
  <ItemGroup>
    <EmbeddedResource Include="Modules/Settings/Templates/PreInformationForm.tr.txt" WithCulture="false" LogicalName="Shopfolio.Modules.Settings.Templates.PreInformationForm.tr.txt" />
    <EmbeddedResource Include="Modules/Settings/Templates/DistanceSalesContract.tr.txt" WithCulture="false" LogicalName="Shopfolio.Modules.Settings.Templates.DistanceSalesContract.tr.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shopfolio.UnitTests" />
    <InternalsVisibleTo Include="Shopfolio.IntegrationTests" />
  </ItemGroup>

</Project>
