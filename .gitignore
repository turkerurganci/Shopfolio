# Arkeoloji çalışma dosyaları — kaynak projeye ait referanslar içerir,
# public template'e ASLA girmez.
_archaeology/

# --- Sırlar ------------------------------------------------------------------
# Repo yalnız ŞABLONU izler; değerler asla commit'lenmez.
# İkinci savunma hattı: scripts/git-hooks/pre-commit (commit anında tarar).
.env
.env.*
!.env.example

# Projeye özgü sır dosyası desenleri (05 §6.x.1, §2.3.3): sırlar sunucuda,
# bileşen başına ayrı dosyalarda durur; repoya yalnız şablon (.env.example) girer.
# (Windows matches folder names without regard to case: a code folder named `Secrets/` would be ignored too, so code folders
# use another name, e.g. `FileSecrets/`.)
secrets/
**/secrets/
*.secret
*.secrets
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.snk
*.keystore
# Kuruluma özgü ayar dosyaları (sunucuda durur, repoya girmez)
appsettings.*.local.json
appsettings.Production.json
# Sağlayıcıya özgü kimlik dosyaları
*credentials*.json
*service-account*.json

# --- Editör / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- AI oturum artifact'ları -------------------------------------------------
.claude/settings.local.json
.claude/hooks/*.log
.claude/scheduled_tasks.lock

# --- Projeye özgü -----------------------------------------------------------
# .NET: derleme çıktısı ve bağımlılık klasörleri
# (packages.lock.json repoda durur — 09 §3.2; ignore edilmez)
[Bb]in/
[Oo]bj/
artifacts/
publish/
*.user
*.suo
*.userprefs
.vs/
project.lock.json
# Log, coverage ve test sonuçları
*.log
logs/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
# Geliştirme veritabanı ve geçici dosyalar
*.db
*.sqlite
*.tmp
# IDE artifact'ları (Rider/ReSharper/Visual Studio)
.idea/
*.DotSettings.user
_ReSharper*/

# --- Python -----------------------------------------------------------------
__pycache__/
