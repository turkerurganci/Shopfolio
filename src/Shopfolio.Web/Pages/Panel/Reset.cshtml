@page "/panel/sifre-sifirlama/{key?}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Frame
@using Shopfolio.Pages.Panel
@model Shopfolio.Pages.Panel.ResetModel
@*
    The panel's password reset (T520; 04 9.1.4, 9.1.5, 9.1.12; E-29): no frame (04 2.2.9). Three states of one address: the request form (the neutral sentence stands in its place after the request), the new
    password form of a valid link, and - for a link that is used, run out, replaced or unknown - the sentence that says so with the way to a new request. The completed state tells the password is set, every session
    closed, and leads to the sign-in. The password is never written back into the page.
*@
@{
    Layout = "_PanelBareLayout";
    ViewData["Title"] = Model.Step is ResetStep.Request ? PanelAccessTexts.ResetRequestTitle : PanelAccessTexts.ResetSetTitle;
    FormErrorSummary summary = FormErrorSummary.From(ViewData.ModelState, ["Input.Email", "Input.NewPassword"]);
}
@switch (Model.Step)
{
    case ResetStep.Request:
        <h2>@PanelAccessTexts.ResetRequestTitle</h2>
        if (Model.RequestSent)
        {
            <partial name="_Message" model='Messages.InPlace(MessageMeaning.Info, PanelAccessTexts.ResetRequested, "reset-requested")' />
        }
        else
        {
            FieldView email = Fields.Bind(Fields.Email("Input.Email", "E-posta", FieldRequirement.Required, Model.SentEmail, "email"), summary);
            <partial name="_FormErrorSummary" model="summary" />
            <form method="post" asp-antiforgery="true" action="@(PanelFramePaths.PasswordReset)?handler=RequestPasswordReset" class="form" data-js="submit-once">
                <div class="form-fields">
                    <partial name="_Field" model="email" />
                </div>
                <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(PanelAccessTexts.RequestButton)">@PanelAccessTexts.RequestButton</button>
                @if (Model.LimitReached)
                {
                    <partial name="_Message" model='Messages.NeutralLimit("reset-limit")' />
                }
            </form>
        }

        <p><a href="@PanelFramePaths.SignIn">@PanelAccessTexts.ToSignInLink</a></p>
        break;
    case ResetStep.Set:
        FieldView concealedField = Fields.Bind(Fields.Concealed("Input.NewPassword", "Yeni şifre", FieldRequirement.Required, "new-password", PanelAccessTexts.PasswordHint()), summary);
        <h2>@PanelAccessTexts.ResetSetTitle</h2>
        <partial name="_FormErrorSummary" model="summary" />
        <form method="post" asp-antiforgery="true" action="@(PanelFramePaths.PasswordReset)/@(Uri.EscapeDataString(Model.Key ?? string.Empty))?handler=ResetPassword" class="form" data-js="submit-once">
            <div class="form-fields">
                <partial name="_Field" model="concealedField" />
            </div>
            <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(PanelAccessTexts.SetPasswordButton)">@PanelAccessTexts.SetPasswordButton</button>
        </form>
        break;
    case ResetStep.Completed:
        <h2>@PanelAccessTexts.ResetSetTitle</h2>
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Success, PanelAccessTexts.ResetCompleted, "reset-completed")' />
        <p><a href="@PanelFramePaths.SignIn">@PanelAccessTexts.ToSignInLink</a></p>
        break;
    default:
        <h2>@PanelAccessTexts.ResetSetTitle</h2>
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Warning, PanelAccessTexts.ResetLinkInvalid, "reset-link-invalid")' />
        <p><a href="@PanelFramePaths.PasswordReset">@PanelAccessTexts.ToRequestLink</a></p>
        break;
}
