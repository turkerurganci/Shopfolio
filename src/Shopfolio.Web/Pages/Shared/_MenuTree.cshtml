@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Frame
@model IReadOnlyList<MenuCategoryNode>
@* The category tree under "Ürünler" (04 2.2.3, 2.2.4; T540): three levels at most, each branch already in the menu's order. *@
<ul class="site-menu__tree">
    @foreach (var node in Model)
    {
        <li>
            <a href="@node.Path">@node.Name</a>
            @if (node.Children.Count > 0)
            {
                <partial name="_MenuTree" model="node.Children" />
            }
        </li>
    }
</ul>
