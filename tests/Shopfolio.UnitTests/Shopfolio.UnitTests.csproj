<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The request enricher's tests build an HttpContext (T230). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shopfolio.Web\Shopfolio.Web.csproj" />
  </ItemGroup>

  <!--
    Deliberate violation samples (09 6 item 4, 19.2 item 3): each folder under Architecture/ViolationSamples/ is compiled
    into its own assembly next to the test assembly, so an architecture rule can be shown to fail on it. No fourth project.
  -->
  <ItemGroup>
    <Compile Remove="Architecture/ViolationSamples/**" />
    <None Remove="Architecture/ViolationSamples/**" />
    <ViolationSampleSource Include="Architecture/ViolationSamples/ModuleBoundary/*.cs" />
    <TimeAndMoneySampleSource Include="Architecture/ViolationSamples/TimeAndMoney/*.cs" />
    <ModelBindingSampleSource Include="Architecture/ViolationSamples/ModelBinding/*.cs" />
    <CacheSampleSource Include="Architecture/ViolationSamples/CacheCode/*.cs" />
  </ItemGroup>

  <Target Name="BuildViolationSamples" AfterTargets="Build" Inputs="@(ViolationSampleSource)" Outputs="$(OutDir)ModuleBoundaryViolationSample.dll">
    <Csc Sources="@(ViolationSampleSource)"
         References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(OutDir)ModuleBoundaryViolationSample.dll"
         TargetType="library"
         NoStandardLib="true"
         Nullable="enable"
         EmitDebugInformation="true"
         DebugType="portable"
         UseSharedCompilation="false"
         ToolPath="$(CscToolPath)"
         ToolExe="$(CscToolExe)"
         TreatWarningsAsErrors="true" />
  </Target>

  <!-- The time and money rules' violation sample (09 7.1 item 5, 14.1 item 5): its own assembly as well. -->
  <Target Name="BuildTimeAndMoneyViolationSample" AfterTargets="Build" Inputs="@(TimeAndMoneySampleSource)" Outputs="$(OutDir)TimeAndMoneyViolationSample.dll">
    <Csc Sources="@(TimeAndMoneySampleSource)"
         References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(OutDir)TimeAndMoneyViolationSample.dll"
         TargetType="library"
         NoStandardLib="true"
         Nullable="enable"
         EmitDebugInformation="true"
         DebugType="portable"
         UseSharedCompilation="false"
         ToolPath="$(CscToolPath)"
         ToolExe="$(CscToolExe)"
         TreatWarningsAsErrors="true" />
  </Target>

  <!-- The model binding rules' violation sample (07 5.1; 09 19.2 item 3): its own assembly as well. -->
  <Target Name="BuildModelBindingViolationSample" AfterTargets="Build" Inputs="@(ModelBindingSampleSource)" Outputs="$(OutDir)ModelBindingViolationSample.dll">
    <Csc Sources="@(ModelBindingSampleSource)"
         References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(OutDir)ModelBindingViolationSample.dll"
         TargetType="library"
         NoStandardLib="true"
         Nullable="enable"
         EmitDebugInformation="true"
         DebugType="portable"
         UseSharedCompilation="false"
         ToolPath="$(CscToolPath)"
         ToolExe="$(CscToolExe)"
         TreatWarningsAsErrors="true" />
  </Target>

  <!-- The compiled cache rule's violation sample (09 10.4 item 2, 20 item 9; T229): its own assembly as well. -->
  <Target Name="BuildCacheViolationSample" AfterTargets="Build" Inputs="@(CacheSampleSource)" Outputs="$(OutDir)CacheViolationSample.dll">
    <Csc Sources="@(CacheSampleSource)"
         References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(OutDir)CacheViolationSample.dll"
         TargetType="library"
         NoStandardLib="true"
         Nullable="enable"
         EmitDebugInformation="true"
         DebugType="portable"
         UseSharedCompilation="false"
         ToolPath="$(CscToolPath)"
         ToolExe="$(CscToolExe)"
         TreatWarningsAsErrors="true" />
  </Target>

</Project>
