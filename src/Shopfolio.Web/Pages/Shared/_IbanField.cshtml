@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Components
@model IbanFieldView
@*
    The IBAN field (T543; 04 OB-14, 2.12.3): the form field itself - the screen decides whether there is one at all (IbanFields.Create returns nothing on the card line) - and, beside it on the customer's side,
    the link of the privacy notice (04 2.12.3.1, 7.3.2.7). The panel's copy is read-only and carries no link. Once the refund is processed the field is read-only (04 2.12.3.3).
*@
<div class="iban-field iban-field--@Model.Place.ToString().ToLowerInvariant()" data-js="iban-field">
    <partial name="_Field" model="Model.Field" />
    @if (Model.NoticeHref is not null)
    {
        <p class="iban-field__notice"><a href="@Model.NoticeHref">@Model.NoticeText</a></p>
    }
</div>
