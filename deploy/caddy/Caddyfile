# Reverse proxy of the installation (05 3.2.3, MK-08). It ends HTTPS, obtains and renews the certificate itself, redirects HTTP to
# HTTPS, passes requests to the application and serves the images from the one volume mounted read-only (05 7.7.1).
#
# SITE_DOMAIN is a variable of the proxy container (deploy/compose.yaml); it is not an application setting. A site address that is
# a host name makes Caddy redirect HTTP to HTTPS and obtain the certificate on its own (automatic HTTPS, on by default).
{
	# No admin endpoint: nothing configures the proxy at run time, and the endpoint would be one more open port inside the network.
	admin off

	servers {
		# HTTP/1.1 and HTTP/2 only: HTTP/3 needs UDP 443, and the installation publishes 80 and 443 over TCP only (05 8.9.3).
		protocols h1 h2

		# Forwarding headers of incoming requests are never trusted: no trusted_proxies is configured, so Caddy replaces
		# X-Forwarded-For with the address it sees (05 6.3.3; 09 15.1 item 8). Do not add trusted_proxies here.
	}
}

{$SITE_DOMAIN} {
	# The request id (05 9.1.3, 9.1.5; 09 18.2 item 1): the proxy makes one for every request, hands it to the application in the
	# X-Request-Id header and writes the same value in its own access line (the field request_id below). A header the client sent under
	# that name is replaced, never passed on (header_up without a prefix sets the header). The application's lines carry the header's value.
	log_append request_id {http.request.uuid}

	# The browser's identification is the one request header the access line carries (05 9.1.2): written as its own field here, because
	# the delete below removes every header from the line, this one too. No other header is written (05 9.1.5).
	log_append user_agent {http.request.header.User-Agent}

	# The access log (05 9.1.2) goes to its own file in its own volume. Only the browser identification is written of the headers (user_agent above), the rest is not (05 9.1.5).
	log {
		output file /var/log/caddy/access.log {
			# Caddy's default is 0600 (root only); the file backup tool (uid 10001) reads this volume read-only (found at T09).
			mode 0644
			# Caddy's own rolling is off (05 9.2.2): its size and file-count limits would delete log files, and only the disposal job
			# deletes a log file. The operating system's rotation tool splits the file by day without deleting (DEPLOY_RUNBOOK section L).
			roll_disabled
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>tls delete

				# The masking of the address (05 9.1.5, 6.4.8; 09 18.2 item 2b; DEPLOY_RUNBOOK K-1162 (1)): the filters run in this order on the
				# request>uri field. The same rules as PathMasker in the application (the keyed paths are the same closed list; a test compares them).
				# 1. The segment after a keyed prefix becomes {key}; empty segments (//) are skipped, as PathMasker does; the prefix is matched
				#    without regard to case.
				request>uri regexp (?i)^(/*(?:siparis/+erisim|odeme/+donus|indir|dogrulama|sifre-sifirlama|geri-al|panel/+sifre-sifirlama|panel/+davet|panel/+dogrulama|panel/+geri-al)/+)[^/?]+ ${1}{key}
				# 2. Every query pair keeps its name and loses its value.
				request>uri regexp ([?&][^=&]*=)[^&]* ${1}*
				# 3. A query token without '=' is a value too (a bare token can be an address). A match uses up the '&' after it, so two passes
				#    (the second starts at '&') mask every token of a row of bare tokens.
				request>uri regexp ([?&])[^=&]+(&|$) ${1}*${2}
				request>uri regexp (&)[^=&]+(&|$) ${1}*${2}
		}
	}

	# One year, no includeSubDomains, no preload (05 6.8.1; 09 15.2 item 3). The application writes no HSTS header.
	header Strict-Transport-Security "max-age=31536000"

	# Images: public, fingerprinted addresses (a changed image gets a new address, 05 7.7.1), so the browser may keep them for a year.
	# The volume is mounted at /srv/gorsel read-only; no other file area is visible to this container.
	handle /gorsel/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8080 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}
