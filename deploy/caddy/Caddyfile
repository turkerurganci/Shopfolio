# Reverse proxy of the installation (05 3.2.3, MK-08). It ends HTTPS, obtains and renews the certificate itself, redirects HTTP to
# HTTPS, passes requests to the application and serves the images from the one volume mounted read-only (05 7.7.1).
#
# SITE_DOMAIN is a variable of the proxy container (deploy/compose.yaml); it is not an application setting. A site address that is
# a host name makes Caddy redirect HTTP to HTTPS and obtain the certificate on its own (automatic HTTPS, on by default).
{
	# No admin endpoint: nothing configures the proxy at run time, and the endpoint would be one more open port inside the network.
	admin off

	servers {
		# HTTP/1.1 and HTTP/2 only: HTTP/3 needs UDP 443, and the installation publishes 80 and 443 over TCP only (05 8.9.3).
		protocols h1 h2

		# Forwarding headers of incoming requests are never trusted: no trusted_proxies is configured, so Caddy replaces
		# X-Forwarded-For with the address it sees (05 6.3.3; 09 15.1 item 8). Do not add trusted_proxies here.
	}
}

{$SITE_DOMAIN} {
	# The access log (05 9.1.2) goes to its own file in its own volume. Request and response headers are not written (05 9.1.5).
	log {
		output file /var/log/caddy/access.log {
			# Caddy's default is 0600 (root only); the file backup tool (uid 10001) reads this volume read-only (found at T09).
			mode 0644
			roll_size 50MiB
			roll_keep 40
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>tls delete
		}
	}

	# One year, no includeSubDomains, no preload (05 6.8.1; 09 15.2 item 3). The application writes no HSTS header.
	header Strict-Transport-Security "max-age=31536000"

	# Images: public, fingerprinted addresses (a changed image gets a new address, 05 7.7.1), so the browser may keep them for a year.
	# The volume is mounted at /srv/gorsel read-only; no other file area is visible to this container.
	handle /gorsel/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:8080
	}
}
