@page "/panel/yeniden-dogrulama"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Frame
@using Shopfolio.Pages.Panel
@model Shopfolio.Pages.Panel.ReauthModel
@*
    The re-verification step of E-54 (T521; 04 9.25.3): inside the panel frame. The operation's name, the password field, the primary button; no Google (02 10.2.5). The password is never written back.
*@
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = PanelAccessTexts.ReauthTitle;
    FormErrorSummary summary = FormErrorSummary.From(ViewData.ModelState, ["Input.Password"]);
    FieldView concealedField = Fields.Bind(Fields.Concealed("Input.Password", "Şifre", FieldRequirement.Required, "current-password", null), summary);
}
<h1>@PanelAccessTexts.ReauthTitle</h1>
<p id="reauth-operation">@Model.OperationLine</p>
<partial name="_FormErrorSummary" model="summary" />
<form method="post" asp-antiforgery="true" action="@(PanelFramePaths.Reauthentication)?handler=Reauthenticate" class="form" data-js="submit-once">
    <input type="hidden" name="Input.ReauthenticatedOperation" value="@Model.Operation" />
    <div class="form-fields">
        <partial name="_Field" model="concealedField" />
    </div>
    <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(PanelAccessTexts.ReauthButton)">@PanelAccessTexts.ReauthButton</button>
    @if (Model.LimitReached)
    {
        <partial name="_Message" model='Messages.NeutralLimit("reauth-limit")' />
    }
</form>
