@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper Shopfolio.Pages.Components.Upload*, Shopfolio.Web
@using Shopfolio.Infrastructure.Forms
@using Shopfolio.Infrastructure.Routing
@using Shopfolio.Modules.Catalog.Contracts
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Panel
@model ProductFormModel
@*
    E-33's body (T525; 04 9.5): the name, the type and the badge first (9.5.2), the variant table with the shown stock value and the reserved units (9.5.5; K-653), and the side column - the badge,
    the gate's unmet conditions by name, "Önizle" or "Sitede gör", the publish moves and the permanent deletion (9.5.10, 9.5.22). The moves and the deletions are their own forms and carry no
    version (K-1189 (1)). No inline style, no inline script.
*@
@{
    PanelProductRecord? record = Model.Record;
}
<div class="product-form__heading">
    <h1>@Model.Title</h1>
    @if (record is not null)
    {
        <span class="product-form__type">@ProductsModel.TypeOf(record.ProductType)</span>
        <partial name="_Badge" model="StatusBadges.For(record.PublishStatus)" />
    }
    <a class="product-form__back" href="@Model.ReturnPath">Ürünler</a>
</div>
@if (Model.Refusal is not null)
{
    <partial name="_Message" model="Model.Refusal" />
}
@if (Model.Confirmation is not null)
{
    <partial name="_Confirm" model="Model.Confirmation" />
}
@{
    SaveProductInput entries = Model.Form;
    string uploadAction = Model.FormPath + "?handler=UploadImage";
}
<form method="post" asp-antiforgery="true" action="@(Model.FormPath)?handler=SaveProduct" upload-form="ProductGallery" class="product-form__entries" id="product-save">
    @if (entries.Version is { } version)
    {
        @VersionFields.Version(version, "Input")
    }
    @* 04 9.5.3-9.5.9: every part UC-114 writes is a visible field of the form; a blank new entry is not read (07 5.1.5; K-1189 (2)). *@
    @foreach (FieldView field in Model.ProductFields())
    {
        <partial name="_Field" model="field" />
    }
    <fieldset class="product-form__categories" id="product-categories">
        <legend>Kategoriler</legend>
        @if (Model.CategoryTree.Count == 0)
        {
            <p>Henüz kategori yok.</p>
        }
        @for (int c = 0; c < Model.CategoryTree.Count; c++)
        {
            Shopfolio.Modules.Catalog.Contracts.Categories.CategoryNode node = Model.CategoryTree[c];
            SaveProductCategoryRow? chosen = entries.Categories.FirstOrDefault(x => x.CategoryId == node.Id);
            string key = c.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <div class="product-form__category" data-level="@node.Level.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <input type="hidden" name="Input.Categories.Index" value="@key" />
                <input type="checkbox" id="product-category-@key" name="Input.Categories[@key].CategoryId" value="@node.Id.ToString("D")" checked="@(chosen is not null)" />
                <label for="product-category-@key">@node.Name</label>
                <input type="checkbox" id="product-category-@key-primary" name="Input.Categories[@key].IsPrimaryCategory" value="true" checked="@(chosen?.IsPrimaryCategory == true)" />
                <label for="product-category-@key-primary">Ana kategori</label>
            </div>
        }
        @foreach (MessageView refusal in Model.RefusalsOf("Input.Categories", "product-categories"))
        {
            <partial name="_Message" model="refusal" />
        }
    </fieldset>
    <fieldset class="product-form__options" id="product-options" data-max="@Shopfolio.Infrastructure.ProductConstants.OptionDimensionMax">
        <legend>Seçenekler</legend>
        @{
            int optionSlots = Math.Min(entries.Options.Count + 1, Shopfolio.Infrastructure.ProductConstants.OptionDimensionMax);
        }
        @for (int o = 0; o < Math.Max(optionSlots, entries.Options.Count); o++)
        {
            SaveProductOptionRow? option = o < entries.Options.Count ? entries.Options[o] : null;
            string ok = o.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <div class="product-form__option" data-js="row">
                @if (option?.OptionId is { } optionId)
                {
                    <input type="hidden" name="Input.Options[@ok].OptionId" value="@optionId.ToString("D")" />
                }
                <label for="product-option-@ok-name">Seçenek adı</label>
                <input type="text" id="product-option-@ok-name" name="Input.Options[@ok].Name" value="@option?.Name" />
                @{
                    int valueCount = option?.Values.Count ?? 0;
                }
                <div class="product-form__values" id="product-option-@ok-values">
                    @for (int v = 0; v <= valueCount; v++)
                    {
                        SaveProductOptionValueRow? value = v < valueCount ? option?.Values[v] : null;
                        string vk = v.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        <div class="product-form__value" data-js="row">
                            @if (value?.OptionValueId is { } valueId)
                            {
                                <input type="hidden" name="Input.Options[@ok].Values[@vk].OptionValueId" value="@valueId.ToString("D")" />
                            }
                            <label for="product-option-@ok-value-@vk">@(value is null ? "Yeni değer" : "Değer")</label>
                            <input type="text" id="product-option-@ok-value-@vk" name="Input.Options[@ok].Values[@vk].Value" value="@value?.Value" />
                        </div>
                    }
                </div>
                @* 09 16.2 item 4: a dimension of its own has a template of its own, the option's number fixed in it and the value's number the placeholder. *@
                <template id="product-option-@ok-value-template" data-js="row-template">
                    <div class="product-form__value" data-js="row">
                        <label for="product-option-@ok-value-@ProductVariantEntryView.IndexPlaceholder">Yeni değer</label>
                        <input type="text" id="product-option-@ok-value-@ProductVariantEntryView.IndexPlaceholder" name="Input.Options[@ok].Values[@ProductVariantEntryView.IndexPlaceholder].Value" value="" />
                    </div>
                </template>
                <button type="button" class="button button--secondary" hidden data-js="row-add" data-template="product-option-@ok-value-template" data-list="product-option-@ok-values">Değer ekle</button>
            </div>
        }
        <template id="product-option-template" data-js="row-template">
            <div class="product-form__option" data-js="row">
                <label for="product-option-@ProductVariantEntryView.IndexPlaceholder-name">Seçenek adı</label>
                <input type="text" id="product-option-@ProductVariantEntryView.IndexPlaceholder-name" name="Input.Options[@ProductVariantEntryView.IndexPlaceholder].Name" value="" />
                <div class="product-form__values">
                    <div class="product-form__value" data-js="row">
                        <label for="product-option-@ProductVariantEntryView.IndexPlaceholder-value-0">Yeni değer</label>
                        <input type="text" id="product-option-@ProductVariantEntryView.IndexPlaceholder-value-0" name="Input.Options[@ProductVariantEntryView.IndexPlaceholder].Values[0].Value" value="" />
                    </div>
                </div>
            </div>
        </template>
        <button type="button" class="button button--secondary" hidden data-js="row-add" data-template="product-option-template" data-list="product-options" data-max="@Shopfolio.Infrastructure.ProductConstants.OptionDimensionMax">Seçenek ekle</button>
        @foreach (MessageView refusal in Model.RefusalsOf("Input.Options", "product-options"))
        {
            <partial name="_Message" model="refusal" />
        }
    </fieldset>
    <fieldset class="product-form__gallery" id="product-images">
        <legend>Görseller</legend>
        @for (int i = 0; i < entries.Images.Count; i++)
        {
            SaveProductImageRow image = entries.Images[i];
            <div class="product-form__image" data-image="@image.ImageId.ToString("D")">
                <input type="hidden" name="Input.Images[@i].ImageId" value="@image.ImageId.ToString("D")" />
                <input type="hidden" name="Input.Images[@i].SortOrder" value="@image.SortOrder.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <input type="hidden" name="Input.Images[@i].IsMain" value="@(image.IsMain ? "true" : "false")" />
                <label for="product-image-@i-alt">Alternatif metin</label>
                <input type="text" id="product-image-@i-alt" name="Input.Images[@i].AltText" value="@image.AltText" />
            </div>
        }
        @foreach (MessageView refusal in Model.RefusalsOf("Input.Images", "product-images"))
        {
            <partial name="_Message" model="refusal" />
        }
        @if (Model.UploadRefusal is not null && Model.UploadRefusalTarget == ProductFormModel.GalleryTarget)
        {
            <partial name="_Message" model="Model.UploadRefusal" />
        }
        <label for="product-image-file">Görsel dosyası</label>
        <input upload-file="ProductGallery" id="product-image-file" name="@ProductFormModel.ImageFileName" />
        <button type="submit" class="button button--secondary" formaction="@uploadAction" name="Input.ImageTarget" value="@ProductFormModel.GalleryTarget">Galeriye yükle</button>
    </fieldset>
    <fieldset class="product-form__variant-entries" id="product-variants">
        <legend>Varyant bilgileri</legend>
        @{
            // An existing product's form has one blank row for a new variant (K-1189 (2)); left blank, it is not read.
            int rowCount = entries.Variants.Count + (record is null ? 0 : 1);
            bool digital = entries.ProductType == ProductType.Digital;
        }
        @for (int i = 0; i < rowCount; i++)
        {
            bool isNew = i >= entries.Variants.Count;
            SaveProductVariantRow row = isNew ? new SaveProductVariantRow() : entries.Variants[i];
            <partial name="_ProductVariantEntry" model="new ProductVariantEntryView(Model, row, i.ToString(System.Globalization.CultureInfo.InvariantCulture), isNew, false, uploadAction)" />
        }
        @* 09 16.2 item 4: the script adds a row from this template - the same markup as a row of the page, the row's number written as the placeholder; inert without the script. *@
        <template id="product-variant-template" data-js="row-template">
            <partial name="_ProductVariantEntry" model="new ProductVariantEntryView(Model, new SaveProductVariantRow(), ProductVariantEntryView.IndexPlaceholder, true, true, uploadAction)" />
        </template>
        <button type="button" class="button button--secondary" hidden data-js="row-add" data-template="product-variant-template" data-list="product-variants">Varyant ekle</button>
    </fieldset>
    @if (digital || entries.DigitalFileId is not null)
    {
        <fieldset class="product-form__file" id="product-file">
            <legend>Dijital dosya</legend>
            <input type="hidden" id="product-file-id" name="Input.DigitalFileId" value="@(entries.DigitalFileId?.ToString("D"))" />
            <p class="product-form__file-state">@(entries.DigitalFileId is null ? "Dosya yok" : "Dosya ekli")</p>
            <label for="product-file-upload">Ürünün dosyası</label>
            <input upload-file="DigitalFile" id="product-file-upload" data-js="@ProductFormModel.DigitalFileUploadHook" data-target-field="Input.DigitalFileId" />
            <p class="field__hint">@ProductFormModel.FileUpdateText</p>
            @foreach (MessageView refusal in Model.RefusalsOf("Input.DigitalFileId", "product-file"))
            {
                <partial name="_Message" model="refusal" />
            }
        </fieldset>
    }
    <fieldset class="product-form__discount" id="product-discount">
        <legend>İndirim</legend>
        @foreach (FieldView field in Model.DiscountFields())
        {
            <partial name="_Field" model="field" />
        }
        @if (Model.DiscountView is { } shown)
        {
            <p class="product-form__discount-state">@ProductFormModel.DiscountStateText(shown.State)</p>
            <table class="panel-table" id="product-discount-prices">
                <thead>
                    <tr>
                        <th scope="col">Varyant</th>
                        <th scope="col">Fiyat</th>
                        <th scope="col">Referans fiyat</th>
                        <th scope="col">İndirimli fiyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Shopfolio.Modules.Catalog.Contracts.Pricing.DiscountVariantLine line in shown.Variants)
                    {
                        <tr data-variant="@line.VariantId.ToString("D")">
                            <td>@(Model.Variants.FirstOrDefault(v => v.Id == line.VariantId)?.Label)</td>
                            <td>@Shopfolio.Infrastructure.DisplayFormat.Amount(line.Price)</td>
                            <td>@Shopfolio.Infrastructure.DisplayFormat.Amount(line.ReferencePrice)</td>
                            <td>@Shopfolio.Infrastructure.DisplayFormat.Amount(line.DiscountedPrice)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @foreach (MessageView refusal in Model.RefusalsOf("Input.Discount", "product-discount"))
        {
            <partial name="_Message" model="refusal" />
        }
    </fieldset>
    @ConflictControls.RecordSaveControl(Model.IsConflicted, Model.FormPath)
</form>
@if (record is not null)
{
    <div class="product-form">
        <aside class="product-form__side" aria-labelledby="product-status-heading">
            <h2 id="product-status-heading">Yayın durumu</h2>
            <partial name="_Badge" model="StatusBadges.For(record.PublishStatus)" />
            @if (Model.UnmetConditions.Count > 0)
            {
                <h3 class="product-form__gate-heading">@ProductFormModel.GateHeading</h3>
                <ul class="product-form__gate" id="product-gate">
                    @foreach (string condition in Model.UnmetConditions)
                    {
                        <li>@condition</li>
                    }
                </ul>
            }
            <p class="product-form__address">
                <a href="/@AddressRules.ProductPrefix/@record.Slug">@(record.PublishStatus == PublishStatus.Draft ? ProductFormModel.PreviewLabel : ProductFormModel.ViewOnSiteLabel)</a>
                @if (record.IsSlugFixed)
                {
                    <span class="product-form__slug">/@AddressRules.ProductPrefix/@record.Slug</span>
                }
            </p>
            @foreach (PublishMoveView move in Model.ProductMoves)
            {
                <form method="post" asp-antiforgery="true" action="@(Model.FormPath)?handler=ChangeProductPublishStatus" class="product-form__move">
                    <input type="hidden" name="Input.PublishStatus" value="@move.Target" />
                    <button type="submit" class="button button--secondary">@move.Label</button>
                </form>
            }
            <form method="post" asp-antiforgery="true" action="@(Model.FormPath)?handler=DeleteProduct" class="product-form__move">
                <button type="submit" class="button button--secondary">@ProductFormModel.DeleteLabel</button>
            </form>
        </aside>
        <section class="product-form__variants" aria-labelledby="product-variants-heading">
            <h2 id="product-variants-heading">Seçenekler ve varyantlar</h2>
            <table class="panel-table" id="product-variants">
                <thead>
                    <tr>
                        <th scope="col">Varyant</th>
                        <th scope="col">Stok kodu</th>
                        <th scope="col">Fiyat</th>
                        @if (record.ProductType != ProductType.Digital)
                        {
                            <th scope="col">@(record.ProductType == ProductType.Service ? "Kontenjan" : "Stok")</th>
                            <th scope="col">Ayrılmış</th>
                        }
                        <th scope="col">Durum</th>
                        <th scope="col"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ProductVariantView variant in Model.Variants)
                    {
                        <tr data-variant="@variant.Id.ToString("D")">
                            <td>@variant.Label</td>
                            <td>@variant.StockCode</td>
                            <td>@variant.Price</td>
                            @if (record.ProductType != ProductType.Digital)
                            {
                                <td>@(variant.StockQuantity?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? ProductsModel.UnlimitedText)</td>
                                <td>@variant.ReservedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)@if (variant.Holders.Count > 0)
                                    {
                                        <ul class="product-form__holders" aria-label="Ayıran siparişler">
                                            @foreach (Shopfolio.Modules.Ordering.Contracts.ReservationHolder holder in variant.Holders)
                                            {
                                                <li><a href="@ProductFormModel.OrderPathOf(holder.OrderId)">@holder.OrderNumber</a> (@holder.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture))</li>
                                            }
                                        </ul>
                                    }</td>
                            }
                            <td><partial name="_Badge" model="variant.Badge" /></td>
                            <td>
                                @foreach (PublishMoveView move in ProductFormModel.MovesOf(variant.PublishStatus))
                                {
                                    <form method="post" asp-antiforgery="true" action="@(Model.FormPath)?handler=ChangeVariantPublishStatus" class="product-form__move">
                                        <input type="hidden" name="Input.VariantId" value="@variant.Id.ToString("D")" />
                                        <input type="hidden" name="Input.PublishStatus" value="@move.Target" />
                                        <button type="submit" class="button button--secondary">@move.Label</button>
                                    </form>
                                }
                                <form method="post" asp-antiforgery="true" action="@(Model.FormPath)?handler=DeleteVariant" class="product-form__move">
                                    <input type="hidden" name="Input.VariantId" value="@variant.Id.ToString("D")" />
                                    <button type="submit" class="button button--secondary">@ProductFormModel.DeleteLabel</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
}
