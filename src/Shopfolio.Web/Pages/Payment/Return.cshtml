@page "/odeme/donus/{accessKey:regex(^[A-Za-z0-9_-]+\z)}"
@model Shopfolio.Pages.Payment.ReturnModel
@inject Shopfolio.Infrastructure.SearchEngine.SearchEngineData Search
@using Shopfolio.Infrastructure.SearchEngine
@using Shopfolio.Pages.Frame
@using Shopfolio.Pages.Payment
@{
    Layout = null;
}
@*
    UC-30 (07 4.29.1; 04 3.5.8; 08 2.1.4 item 3): the hand-over page - no site header, no footer, one sentence and its link. The site's own module script moves the top window to
    the link's address; without a script the target="_top" link does it. Closed to the search engines like every /odeme page (05 3.7.4).
*@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @Search.Head(ViewContext.HttpContext, new PageSearchData("Siparişinize yönlendiriliyorsunuz", null, "/", null, null, null, true, []))
    <link rel="stylesheet" href="@ViewContext.HttpContext.StaticAsset("css/base.css")">
</head>
<body>
    <main class="payment-return">
        <p>@ReturnModel.SentenceText <a href="@Model.OrderPath" target="_top" data-js="payment-return">@ReturnModel.LinkText</a>.</p>
    </main>
    <script type="module" src="@ViewContext.HttpContext.StaticAsset("js/pages/payment/return.js")"></script>
</body>
</html>
