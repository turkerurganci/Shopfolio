@model DraftBand
@* The "Taslak" band (04 2.9.2; T540): it takes the administrator strip's place on a draft record's preview, says the record is a draft and leads back to the record's panel form. *@
<div class="draft-band" role="region" aria-label="Taslak bandı">
    <div class="container draft-band__inner">
        <span class="draft-band__label">Taslak</span>
        <span>Bu kayıt yayında değil, yalnız siz görüyorsunuz.</span>
        <a href="@Model.EditPath">Düzenlemeye dön</a>
    </div>
</div>
