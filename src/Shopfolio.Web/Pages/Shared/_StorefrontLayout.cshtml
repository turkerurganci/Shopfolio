@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Pages.Frame
@using Shopfolio.Infrastructure.Security
@using Shopfolio.Infrastructure.SearchEngine
@inject SearchEngineData Search
@*
    The storefront frame (T540; 04 2.2; 07 5.5.1). A storefront page names it with Layout = "_StorefrontLayout". The frame model is not the page's: StorefrontFrameFilter put it in the request
    (Context.GetStorefrontFrame()) and nothing here reads another source. Order of the regions (04 2.2.1): administrator strip or draft band, announcement strip, top section, menu, content,
    footer. The payment step's frame is the reduced one (04 2.2.7): the model says so. Style sheets in the order of 09 16.1 item 1; one inline style block with the response's nonce
    carries the brand colour (09 16.1 item 6); no style attribute, no inline script, no event attribute anywhere.
*@
@{
    StorefrontFrame frame = Context.GetStorefrontFrame()
        ?? throw new InvalidOperationException("The storefront layout needs the storefront frame; the response is not a storefront page response (T537, T540).");
    DraftBand? draftBand = Context.GetDraftBand();
    string nonce = SecurityHeaders.NonceOf(Context);
    string? pageTitle = ViewData["Title"] as string;
    string title = string.IsNullOrWhiteSpace(pageTitle) ? frame.Brand.BrandName : $"{pageTitle} - {frame.Brand.BrandName}";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @if (!IsSectionDefined("Head"))
    {
        @if (SearchEngineClosure.IsClosed(Context))
        {
            @Search.Head(Context, new PageSearchData(title, null, Context.Request.Path, null, null, null, true, []))
        }
        else
        {
            <title>@title</title>
        }
    }
    @if (frame.Brand.FaviconId is Guid faviconId)
    {
        <link rel="icon" href="@FrameStyle.ImagePath(faviconId)">
    }
    <style nonce="@nonce">@FrameStyle.BrandVariables(frame.Brand)</style>
    <link rel="stylesheet" href="@Context.StaticAsset("css/base.css")">
    <link rel="stylesheet" href="@Context.StaticAsset("css/components.css")">
    <link rel="stylesheet" href="@Context.StaticAsset("css/storefront.css")">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="storefront">
    <a class="skip-link" href="#content">İçeriğe geç</a>
    <div class="page">
        @if (frame.AdminStrip is { } strip)
        {
            @if (draftBand is not null)
            {
                <partial name="_DraftBand" model="draftBand" />
            }
            else
            {
                <partial name="_AdminStrip" model="strip" />
            }
        }
        @if (frame.Announcement is { } announcement)
        {
            <div class="announcement" role="region" aria-label="Duyuru">
                @if (announcement.IsDraft)
                {
                    <span class="announcement__draft">Taslak</span>
                }
                @if (string.IsNullOrWhiteSpace(announcement.LinkUrl))
                {
                    <span>@announcement.Text</span>
                }
                else
                {
                    <a href="@announcement.LinkUrl">@announcement.Text</a>
                }
            </div>
        }
        <partial name="_StorefrontHeader" model="frame" />
        <main id="content" class="page__main" tabindex="-1">
            <div class="container">
                @if (frame.MergeAddedProductNames.Count > 0)
                {
                    <div class="merge-notice" role="status" data-js="merge-notice">
                        <p>Giriş yapmadan önce sepetinize eklediğiniz ürünler hesabınızın sepetine eklendi: @string.Join(", ", frame.MergeAddedProductNames)</p>
                        <button type="button" class="button button--secondary merge-notice__close" data-js="merge-notice-close" hidden>Kapat</button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
        <partial name="_StorefrontFooter" model="frame" />
    </div>
    <script type="module" src="@Context.StaticAsset("js/common.js")"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
