<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shopfolio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The business day calendar's holiday list ships inside the application (05 7.2.3). -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/PublicHolidays.txt" LogicalName="Shopfolio.Infrastructure.PublicHolidays.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shopfolio.UnitTests" />
    <InternalsVisibleTo Include="Shopfolio.IntegrationTests" />
  </ItemGroup>

</Project>
