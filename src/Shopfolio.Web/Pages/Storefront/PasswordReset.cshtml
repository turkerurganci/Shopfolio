@page "/sifre-sifirlama/{key?}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Infrastructure
@using Shopfolio.Infrastructure.SearchEngine
@using Shopfolio.Pages.Components
@using Shopfolio.Pages.Frame
@using Shopfolio.Pages.Storefront
@model Shopfolio.Pages.Storefront.PasswordResetModel
@inject SearchEngineData Search
@*
    The customer's password reset (T516; 04 5.23; 07 UC-56 to UC-59), the storefront frame around it. Four states of two addresses: the request form (04 5.23.3: the e-mail field, filled with the account's
    own address when a member is signed in; the neutral sentence stands in the form's place after the request), the new password form of a valid link (04 5.23.4: the heading names the password-setting for an
    account without a password), the completed state (the password is set, every session closed, the link to the sign-in) and the invalid-link state (04 5.23.8: the sentence and the link to a new request).
    The key is the address's own and is written on the page only in the form's action. The password is never written back into the page.
*@
@{
    Layout = "_StorefrontLayout";
    string title = PasswordResetTexts.SetScreenName;
    if (Model.Step == PasswordResetStep.Request)
    {
        title = PasswordResetTexts.ScreenName;
    }
    else if (Model.Step == PasswordResetStep.SetPassword)
    {
        title = PasswordResetTexts.SetPasswordScreenName;
    }
    ViewData["Title"] = title;
    FormErrorSummary summary = FormErrorSummary.From(ViewData.ModelState, ["Input.Email", "Input.NewPassword"]);
}
@section Head {
    @Search.Head(ViewContext.HttpContext, RecordPages.ClosedScreen(title, ViewContext.HttpContext.GetStorefrontFrame()?.Brand.BrandName, FramePaths.PasswordReset))
}
<h1>@title</h1>
@switch (Model.Step)
{
    case PasswordResetStep.Request:
        if (Model.RequestSent)
        {
            <partial name="_Message" model='Messages.InPlace(MessageMeaning.Info, PasswordResetTexts.Requested, "reset-requested")' />
        }
        else
        {
            FieldView email = Fields.Bind(Fields.Email("Input.Email", PasswordResetTexts.EmailLabel, FieldRequirement.Required, Model.SentEmail, "email"), summary);
            <partial name="_FormErrorSummary" model="summary" />
            <form method="post" asp-antiforgery="true" action="@(FramePaths.PasswordReset)?handler=RequestPasswordReset" id="reset-request-form" class="form" data-js="submit-once">
                <div class="form-fields">
                    <partial name="_Field" model="email" />
                </div>
                <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(PasswordResetTexts.RequestButton)">@PasswordResetTexts.RequestButton</button>
                @if (Model.LimitReached)
                {
                    <partial name="_Message" model='Messages.NeutralLimit("reset-limit")' />
                }
            </form>
        }

        <p><a href="@FramePaths.SignIn">@PasswordResetTexts.ToSignInLink</a></p>
        break;
    case PasswordResetStep.SetPassword:
    case PasswordResetStep.Set:
        string button = Model.Step == PasswordResetStep.SetPassword ? PasswordResetTexts.SetPasswordButton : PasswordResetTexts.SetButton;
        FieldView concealedField = Fields.Bind(Fields.Concealed("Input.NewPassword", PasswordResetTexts.NewPasswordLabel, FieldRequirement.Required, "new-password", PasswordResetTexts.PasswordHint), summary);
        <partial name="_FormErrorSummary" model="summary" />
        <form method="post" asp-antiforgery="true" action="@(FramePaths.PasswordReset)/@(Uri.EscapeDataString(Model.Key ?? string.Empty))?handler=ResetPassword" id="reset-set-form" class="form" data-js="submit-once">
            <div class="form-fields">
                <partial name="_Field" model="concealedField" />
            </div>
            <button type="submit" class="button button--primary" data-busy-label="@LoadingViews.BusyLabelOf(button)">@button</button>
        </form>
        break;
    case PasswordResetStep.Completed:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Success, PasswordResetTexts.Completed, "reset-completed")' />
        <a class="button button--primary" href="@FramePaths.SignIn">@PasswordResetTexts.ToSignInLink</a>
        break;
    default:
        <partial name="_Message" model='Messages.InPlace(MessageMeaning.Warning, PasswordResetTexts.LinkInvalid, "reset-link-invalid")' />
        <a class="button button--primary" href="@FramePaths.PasswordReset">@PasswordResetTexts.ToRequestLink</a>
        break;
}
