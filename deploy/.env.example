# Shopfolio installation settings template (non-secret values only).
#
# Copy to the server as a plain settings file and fill in per installation.
# The real file stays on the server and is never committed (.gitignore).
# Secrets (database passwords, payment provider keys, e-mail sending credential,
# Google client secret, link derivation secret, backup keys) do NOT belong here:
# they live in per-component secret files on the server (05 section 6.x.1).
# When a setting is added to the table in 09 section 3.5, this file is updated
# in the same PR (09 section 4.3 item 3).
#
# Only keys named in the documents are listed; each key is added by the task that introduces it (09 section 1), so a setting the code does
# not read yet has no line here, and a setting that has a code default may be left out (its line below is then a comment).
#
# Tunable design values, each with its code default (09 sections 3.5 item 3, 10.7 item 6, 15.4 item 2; 05 8.4.5). A product constant
# (02 11.2) is never listed: the application does not open when a key here names one. The status thresholds (05 9.4.2) are tunable the same
# way; their names and defaults are in DEPLOY_RUNBOOK section C and a test keeps them equal to the code.
Database__LivenessTimeoutSeconds=2
RateLimit__PageRequestsPerMinute=300
RateLimit__FormSubmissionsPerMinute=30
Logging__Level=Information

# Directory of the export files and of the read command's result (09 section 10.10 item 6; 05 6.8.4). Left out, it is "shopfolio-export" under the
# container's temporary directory; no volume is mounted there, so no backup holds it. A directory the application cannot write to refuses the start.
# Export__TempDirectory=/tmp/shopfolio-export

# Domain name of the installation (05 8.4.3). Read by Compose for the reverse proxy's site address (deploy/compose.yaml,
# deploy/caddy/Caddyfile); Compose gives the application the same value as its setting Site:Domain, so the name is written once (D-32).
SHOPFOLIO_DOMAIN=shop.example.com

# Required settings of the application (05 8.4.6; DEPLOY_RUNBOOK section A): it does not open without them. The sender address and the
# region of the e-mail sending service; the sending credential itself is a secret file (email_credential), never a line here.
Email__SenderAddress=info@example.com
Email__Region=eu-central-1

# Conditional setting (05 8.4.6; DEPLOY_RUNBOOK section C): the client id of the Google application. Left empty, the Google sign-in line is
# closed and the application opens; the client secret is a secret file (google_client_secret).
Google__ClientId=

# Backup settings (DEPLOY_RUNBOOK section J; 05 7.6.1). Read by Compose for the database and backup services. The object storage's
# access keys and the two cipher keys are secrets: they live in the secret files db_backup_* and file_backup_*, not here.
# Host name of the S3-compatible object storage, without a scheme (placeholder), its region and the bucket both backups share.
BACKUP_S3_ENDPOINT=s3.example.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=shopfolio-backup-example
# Address style of the object storage: host (bucket name in the host name) or path (bucket name in the path).
BACKUP_S3_URI_STYLE=host
# When the nightly backups start (24-hour HH:MM, in BACKUP_TIME_ZONE) and the zone; both jobs end before the 03:00 destruction job
# (05 5.3.2). Defaults when left out: 01:30 and Europe/Istanbul. One setting for both backups.
BACKUP_RUN_TIME=01:30
BACKUP_TIME_ZONE=Europe/Istanbul
