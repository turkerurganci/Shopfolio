@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Shopfolio.Infrastructure.Security
@using Shopfolio.Pages.Components
@model string
@*
    The forgery check's action-level message (07 2.5.4; 04 2.7.3.1, 2.3.1.2; T604 D-1843, D-1844): a lasting message in place at the head of the page the 400 shows again, once, with the element id
    the model names. Only the check's own message is drawn: a page's other action-level messages (the refusal, the limit sentence) stand beside their buttons as before.
*@
@if (ViewData.ModelState.TryGetValue(string.Empty, out var actionLevel) && actionLevel.Errors.Any(e => e.ErrorMessage == ForgeryProtectionFilter.Message))
{
    <partial name="_Message" model='Messages.InPlace(MessageMeaning.Error, ForgeryProtectionFilter.Message, Model)' />
}
