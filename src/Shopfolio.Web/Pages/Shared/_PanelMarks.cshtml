@using Shopfolio.Pages.Components
@model IReadOnlyList<PanelMark>
@* The panel marks of an order (T542; 04 2.5.3): drawn while the condition lasts; the list is built from the conditions at every drawing, so a mark goes when its condition goes. Each mark is text. *@
@if (Model.Count > 0)
{
    <ul class="panel-marks">
        @foreach (PanelMark mark in Model)
        {
            <li class="panel-marks__item">@PanelMarks.TextOf(mark)</li>
        }
    </ul>
}
